    _lastWidget: Widget,
    SelectionImageObject: Frame,
    parentInstance: Instance,
    _utility: WidgetUtility,

    -- Config
    _rootConfig: Config,
    _config: Config,

    -- ID
    _IDStack: { ID },
    _usedIDs: { [ID]: number },
    _pushedId: ID?,
